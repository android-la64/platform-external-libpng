// We need to build this for both the device (as a shared library)
// and the host (as a static library for tools to use).

package {
    default_applicable_licenses: ["external_libpng_license"],
}

// Added automatically by a large-scale-change that took the approach of
// 'apply every license found to every target'. While this makes sure we respect
// every license restriction, it may not be entirely correct.
//
// e.g. GPL in an MIT project might only apply to the contrib/ directory.
//
// Please consider splitting the single license below into multiple licenses,
// taking care not to lose any license_kind information, and overriding the
// default license using the 'licenses: [...]' property on targets as needed.
//
// For unused files, consider creating a 'fileGroup' with "//visibility:private"
// to attach the license to, and including a comment whether the files may be
// used in the current project.
//
// large-scale-change filtered out the below license kinds as false-positives:
//   SPDX-license-identifier-GPL
//   SPDX-license-identifier-GPL-2.0
//   SPDX-license-identifier-LGPL
// See: http://go/android-license-faq
license {
    name: "external_libpng_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD",
        "SPDX-license-identifier-CC0-1.0",
        "SPDX-license-identifier-MIT",
        "SPDX-license-identifier-W3C",
        "SPDX-license-identifier-Zlib",
        "legacy_notice",
        "legacy_unencumbered",
    ],
    license_text: [
        "LICENSE",
    ],
}

cc_defaults {
    name: "libpng-defaults",
    exclude_srcs: [
        "example.c",
        "pngtest.c",
    ],
    srcs: ["*.c"],
    cflags: [
        "-std=gnu89",
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
    arch: {
        arm: {
            srcs: ["arm/*"],
            cflags: ["-O3"],
        },
        arm64: {
            srcs: ["arm/*",],
            cflags: ["-O3"],
            exclude_srcs: [
                "arm/filter_neon.S"
            ],
        },
        x86: {
            srcs: ["intel/*"],
            // Disable optimizations because they crash on windows
            // cflags: ["-DPNG_INTEL_SSE_OPT=1"],
        },
        x86_64: {
            srcs: ["intel/*"],
            // Disable optimizations because they crash on windows
            // cflags: ["-DPNG_INTEL_SSE_OPT=1"],
        },
    },
    shared_libs: ["libz"],
    target: {
        android_x86: {
            cflags: ["-DPNG_INTEL_SSE_OPT=1"],
        },
        android_x86_64: {
            cflags: ["-DPNG_INTEL_SSE_OPT=1"],
        },
    },
    export_include_dirs: ["."],
}

// For the host and device platform
// =====================================================

cc_library {
    name: "libpng",
    arch: {
        loongarch64: {
            srcs: ["loongarch/loongarch_lsx_init.c"],
            cflags: ["-DPNG_LOONGARCH_LSX_OPT=1", "-mno-lsx", "-mno-lasx"],
            lto: { never: true },
            whole_static_libs: ["libpng_lsx"],
        },
    },
    vendor_available: true,
    product_available: true,
    // TODO(b/153609531): remove when no longer needed.
    native_bridge_supported: true,
    recovery_available: true,
    double_loadable: true,
    host_supported: true,
    defaults: ["libpng-defaults"],
    target: {
        windows: {
            enabled: true,
        },
    },

    sdk_version: "current",
    min_sdk_version: "apex_inherit",
    apex_available: [
        "com.android.mediaprovider",
        "//apex_available:platform"
    ],
}

// For the device (static) for NDK
// =====================================================

cc_library_static {
    name: "libpng_ndk",
    arch: {
        loongarch64: {
            srcs: ["loongarch/loongarch_lsx_init.c"],
            cflags: ["-DPNG_LOONGARCH_LSX_OPT=1", "-mno-lsx", "-mno-lasx"],
            lto: { never: true },
            whole_static_libs: ["libpng_ndk_lsx"],
        },
    },
    defaults: ["libpng-defaults"],
    cflags: ["-ftrapv"],

    shared_libs: ["libz"],
    sdk_version: "minimum",
}

// For testing
// =====================================================

cc_test {
    host_supported: true,
    gtest: false,
    srcs: ["pngtest.c"],
    name: "pngtest",
    cflags: ["-Wall", "-Werror"],
    shared_libs: [
        "libpng",
        "libz",
    ],
}

cc_fuzz {
    name: "libpng_read_fuzzer",
    host_supported:true,

    static_libs: [
        "libpng",
        "libz",
    ],

    srcs: [
        "contrib/oss-fuzz/libpng_read_fuzzer.cc",
    ],

    dictionary: "contrib/oss-fuzz/png.dict",

    corpus: ["contrib/testpngs/*.png"],

    fuzz_config: {
        cc: [
            "scroggo@google.com",
        ],
        componentid: 87896,
    },
}

// LSX filter kernels are selected at runtime through AT_HWCAP.
cc_defaults {
    name: "libpng-lsx-defaults",
    enabled: false,
    arch: { loongarch64: { enabled: true } },
    srcs: ["loongarch/filter_lsx_intrinsics.c"],
    cflags: [
        "-std=gnu89", "-Wall", "-Werror", "-Wno-unused-parameter",
        "-DPNG_LOONGARCH_LSX_OPT=1", "-mlsx", "-mno-lasx", "-fvisibility=hidden",
    ],
    shared_libs: ["libz"],
    lto: { never: true },
    visibility: ["//visibility:private"],
}

cc_library_static {
    name: "libpng_lsx",
    defaults: ["libpng-lsx-defaults"],
    vendor_available: true,
    product_available: true,
    native_bridge_supported: true,
    recovery_available: true,
    host_supported: true,
    sdk_version: "current",
    min_sdk_version: "apex_inherit",
    apex_available: ["com.android.mediaprovider", "//apex_available:platform"],
}

cc_library_static {
    name: "libpng_ndk_lsx",
    defaults: ["libpng-lsx-defaults"],
    cflags: ["-ftrapv"],
    sdk_version: "minimum",
}

// LoongArch LSX integration tests (local addition)
// =====================================================
// Private, uninstallable, loongarch64-only test builds.  Profiles:
//   pc: production configuration, PNG_LOONGARCH_LSX_OPT=0, no init/helper.
//   pl: the production libpng itself (no separate test library).
//   dc: pc plus PNG_WARNINGS_SUPPORTED=1 (diagnostic test build only).
//   dl: pl plus PNG_WARNINGS_SUPPORTED=1, with its own LSX helper.
// None of these replace libpng or libpng_ndk.

cc_defaults {
    name: "libpng-t061b-loongarch64-only",
    enabled: false,
    arch: { loongarch64: { enabled: true } },
}

cc_library_shared {
    name: "libpng_t061b_pc",
    defaults: ["libpng-defaults", "libpng-t061b-loongarch64-only"],
    arch: {
        loongarch64: {
            cflags: ["-DPNG_LOONGARCH_LSX_OPT=0", "-mno-lsx", "-mno-lasx"],
            lto: { never: true },
        },
    },
    installable: false,
    visibility: ["//visibility:private"],
}

cc_library_shared {
    name: "libpng_t061b_dc",
    defaults: ["libpng-defaults", "libpng-t061b-loongarch64-only"],
    arch: {
        loongarch64: {
            cflags: [
                "-DPNG_LOONGARCH_LSX_OPT=0", "-mno-lsx", "-mno-lasx",
                "-DPNG_WARNINGS_SUPPORTED=1",
            ],
            lto: { never: true },
        },
    },
    installable: false,
    visibility: ["//visibility:private"],
}

cc_library_static {
    name: "libpng_t061b_dl_lsx",
    defaults: ["libpng-lsx-defaults"],
    cflags: ["-DPNG_WARNINGS_SUPPORTED=1"],
}

cc_library_shared {
    name: "libpng_t061b_dl",
    defaults: ["libpng-defaults", "libpng-t061b-loongarch64-only"],
    arch: {
        loongarch64: {
            srcs: ["loongarch/loongarch_lsx_init.c"],
            cflags: [
                "-DPNG_LOONGARCH_LSX_OPT=1", "-mno-lsx", "-mno-lasx",
                "-DPNG_WARNINGS_SUPPORTED=1",
            ],
            lto: { never: true },
            whole_static_libs: ["libpng_t061b_dl_lsx"],
        },
    },
    installable: false,
    visibility: ["//visibility:private"],
}

// Per-profile test program settings: each profile's programs use the same
// feature macros and baseline ISA as the library they link against.

cc_defaults {
    name: "libpng-t061b-pc-test-defaults",
    defaults: ["libpng-t061b-loongarch64-only"],
    cflags: ["-Wall", "-Werror", "-fno-inline", "-g"],
    arch: {
        loongarch64: {
            cflags: ["-DPNG_LOONGARCH_LSX_OPT=0", "-mno-lsx", "-mno-lasx"],
            lto: { never: true },
        },
    },
    shared_libs: ["libpng_t061b_pc", "libz", "libm"],
}

cc_defaults {
    name: "libpng-t061b-pl-test-defaults",
    defaults: ["libpng-t061b-loongarch64-only"],
    cflags: ["-Wall", "-Werror", "-fno-inline", "-g"],
    arch: {
        loongarch64: {
            cflags: ["-DPNG_LOONGARCH_LSX_OPT=1", "-mno-lsx", "-mno-lasx"],
            lto: { never: true },
        },
    },
    shared_libs: ["libpng", "libz", "libm"],
}

cc_defaults {
    name: "libpng-t061b-dc-test-defaults",
    defaults: ["libpng-t061b-loongarch64-only"],
    cflags: ["-Wall", "-Werror", "-fno-inline", "-g"],
    arch: {
        loongarch64: {
            cflags: [
                "-DPNG_LOONGARCH_LSX_OPT=0", "-mno-lsx", "-mno-lasx",
                "-DPNG_WARNINGS_SUPPORTED=1",
            ],
            lto: { never: true },
        },
    },
    shared_libs: ["libpng_t061b_dc", "libz", "libm"],
}

cc_defaults {
    name: "libpng-t061b-dl-test-defaults",
    defaults: ["libpng-t061b-loongarch64-only"],
    cflags: ["-Wall", "-Werror", "-fno-inline", "-g"],
    arch: {
        loongarch64: {
            cflags: [
                "-DPNG_LOONGARCH_LSX_OPT=1", "-mno-lsx", "-mno-lasx",
                "-DPNG_WARNINGS_SUPPORTED=1",
            ],
            lto: { never: true },
        },
    },
    shared_libs: ["libpng_t061b_dl", "libz", "libm"],
}

