// Static consumer of the production libpng, for ISA isolation checks of a
// statically linked image.  Other system libraries stay dynamic.
cc_test {
    name: "t061b_static_pngtest",
    defaults: ["libpng-t061b-loongarch64-only"],
    gtest: false,
    srcs: ["pngtest.c"],
    cflags: ["-Wall", "-Werror", "-fno-inline", "-g"],
    arch: {
        loongarch64: {
            cflags: ["-DPNG_LOONGARCH_LSX_OPT=1", "-mno-lsx", "-mno-lasx"],
            lto: { never: true },
        },
    },
    static_libs: ["libpng"],
    shared_libs: ["libz", "libm"],
}
